[Unit]
Description=Sunshine streaming over Tailscale (remote-play.sh)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash %h/scripts/remote-play.sh serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
