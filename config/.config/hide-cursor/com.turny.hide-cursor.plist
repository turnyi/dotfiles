<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.turny.hide-cursor</string>

  <!-- Hides the cursor after 3s without mouse use, matching Hyprland's
       cursor:inactive_timeout. See .config/hide-cursor/hide-cursor.swift. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/turny/scripts/hide-cursor.sh</string>
    <string>3</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardErrorPath</key>
  <string>/Users/turny/.cache/hide-cursor/err.log</string>
</dict>
</plist>
